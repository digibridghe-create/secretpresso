{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Coffee and food categories",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "displayOrder": { "type": "number" },
        "isVisible": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Section": {
      "title": "Section",
      "description": "Homepage dynamic sections",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "subtitle": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 500 },
        "displayStyle": { "type": "string", "maxLength": 50 },
        "displayOrder": { "type": "number" },
        "isVisible": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Product": {
      "title": "Product",
      "description": "Specialty coffee and food items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "price": { "type": "number" },
        "salePrice": { "type": ["number", "null"] },
        "image": { "type": "string", "maxLength": 500 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "sectionId": { "type": "string", "maxLength": 128 },
        "productType": { "type": "string", "maxLength": 50 },
        "availability": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "isVisible": { "type": "boolean" },
        "badge": { "type": "string", "maxLength": 100 },
        "surpriseToyNote": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerEmail": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 50 },
        "deliveryAddress": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 500 },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "maxLength": 50 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "customerName", "total"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer user profile and saved addresses",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "displayName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "addresses": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Catalog categories"
    },
    "/sections/{sectionId}": {
      "schema": "Section",
      "description": "Homepage dynamic sections"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products catalogue"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    }
  }
}
