rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /products/{id} {
      allow read, write: if true;
    }
    match /categories/{id} {
      allow read, write: if true;
    }
    match /sections/{id} {
      allow read, write: if true;
    }
    match /banners/{id} {
      allow read, write: if true;
    }
    match /media/{id} {
      allow read, write: if true;
    }
    match /settings/{id} {
      allow read, write: if true;
    }
    match /orders/{id} {
      allow read, write: if true;
    }
    match /backups/{id} {
      allow read, write: if true;
    }
    match /auditLogs/{id} {
      allow read, write: if true;
    }
    match /customers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
